# Database
DATABASE_URL="file:./prisma/dev.db"

# For production: switch to Postgres
# DATABASE_URL="postgresql://user:pass@localhost:5432/ruthex_lms"

# Auth
JWT_SECRET="change-me-in-production-use-32-plus-random-bytes"
SESSION_TTL_HOURS=8

# Mobile money integrations (mock by default; swap providers for production)
MOBILE_MONEY_PROVIDER=mock  # mock | mtn | airtel | zamtel
MOBILE_MONEY_WEBHOOK_SECRET=change-me

# CTR threshold (USD 10,000 — set by S.I. 52 of 2016)
CTR_THRESHOLD_USD=10000

# Reporting
BOZ_REPORT_FROM_EMAIL=reports@ruthex.local
NEXT_PUBLIC_APP_NAME="RUTHEX Lending Institution"
NEXT_PUBLIC_APP_TAGLINE="Microfinance, done right."
