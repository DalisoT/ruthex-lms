{
  // Cloudflare Workers config for the RUTHEX LMS OpenNext build.
  //
  // Workers (NOT Pages) — confirmed by the *.workers.dev URL on the dashboard.
  //
  // `main` points at the OpenNext-built worker bundle that handles SSR + API routes.
  // `assets.directory` is the static-asset bucket OpenNext emits; `binding: ASSETS`
  // makes it accessible to the worker as `env.ASSETS`.
  // `nodejs_compat` is required because Prisma + bcryptjs need Node APIs.
  // `placement.smart` lets Cloudflare pick the lowest-latency region.
  // `observability.enabled` flips on Workers Logs + Analytics Engine for free.
  "name": "ruthex-lms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  }
}
